# TRISHUL AI - Environment Variables
# Copy this file to .env and fill in your values

# Demo Mode - Set to true to see all features
VITE_DEMO_MODE=true

# Map
VITE_MAP_CENTER_LAT=17.3850
VITE_MAP_CENTER_LNG=78.4867
VITE_MAP_ZOOM=9

# API Base URL (for future integration)
VITE_API_BASE_URL=http://localhost:3001

# Feature Flags
VITE_ENABLE_REAL_SENSORS=false
VITE_ENABLE_SATELLITE_API=false
VITE_ENABLE_WEATHER_API=false
